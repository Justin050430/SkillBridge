classDiagram
direction TB

class Role {
    +int id
    +string role_name
    +Collection~User~ users
}
class User {
    +int id
    +string email
    +string status
    +Role role
    +Collection~Course~ courses
    +Collection~Enrollment~ enrollments
    +Collection~Notification~ notifications
}
class Category {
    +int id
    +string category_name
    +Collection~Course~ courses
}
class Course {
    +int id
    +string title
    +string status
    +User mentor
    +Category category
    +Collection~Lesson~ lessons
    +Collection~Enrollment~ enrollments
}
class Lesson {
    +int id
    +string title
    +string status
    +Course course
    +Collection~LessonResource~ resources
    +Collection~Assessment~ assessments
    +Collection~Progress~ progresses
}
class LessonResource {
    +int id
    +string title
    +string type
    +Lesson lesson
}
class Enrollment {
    +int id
    +string status
    +User student
    +Course course
    +Collection~Progress~ progress
    +Collection~AssessmentAttempt~ assessmentAttempts
}
class Progress {
    +int id
    +string status
    +Enrollment enrollment
    +Lesson lesson
}
class Assessment {
    +int id
    +string title
    +string status
    +Lesson lesson
    +Collection~Question~ questions
    +Collection~AssessmentAttempt~ attempts
}
class Question {
    +int id
    +string question_text
    +string question_type
    +Assessment assessment
    +Collection~StudentAnswer~ studentAnswers
}
class AssessmentAttempt {
    +int id
    +int attempt_number
    +bool is_passed
    +Enrollment enrollment
    +Assessment assessment
    +Collection~StudentAnswer~ studentAnswers
}
class StudentAnswer {
    +int id
    +string submitted_answer
    +bool is_correct
    +AssessmentAttempt attempt
    +Question question
}
class Notification {
    +int id
    +string title
    +bool is_read
    +User user
}

Role "1" -- "0..*" User : assigned role
User "1" -- "0..*" Course : mentors
Category "1" -- "0..*" Course : categorises
Course "1" -- "0..*" Lesson : contains
Lesson "1" -- "0..*" LessonResource : provides
User "1" -- "0..*" Enrollment : student
Course "1" -- "0..*" Enrollment : receives
Enrollment "1" -- "0..*" Progress : records
Lesson "1" -- "0..*" Progress : tracked lesson
Lesson "1" -- "0..*" Assessment : contains
Assessment "1" -- "0..*" Question : contains
Enrollment "1" -- "0..*" AssessmentAttempt : records
Assessment "1" -- "0..*" AssessmentAttempt : attempted assessment
AssessmentAttempt "1" -- "0..*" StudentAnswer : contains
Question "1" -- "0..*" StudentAnswer : answered question
User "1" -- "0..*" Notification : receives
